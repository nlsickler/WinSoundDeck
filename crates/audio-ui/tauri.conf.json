{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSoundDeck",
  "version": "1.0.0",
  "identifier": "io.github.nlsickler.winsounddeck",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinSoundDeck",
        "width": 480,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
